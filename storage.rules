rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      // Anyone can read product images
      allow read: if true;
      // Only admin can upload
      allow write: if request.auth != null 
        && request.auth.token.email == "sadiadmin@ecom.com";
    }
  }
}
